# --- Required ---
GROQ_API_KEY=you_api_key

# --- Optional - Chat Models ---
# PRIMARY_MODEL=llama-3.3-70b-versatile
# FALLBACK_MODEL=llama-3.1-8b-instant

# --- Optional - Wikipedia Dump ---
# DUMP_FILE=plwiki-latest-pages-articles.xml.bz2

# --- Optional - Embedding Model ---
# EMBEDDING_MODEL__MODEL=intfloat/multilingual-e5-base
# EMBEDDING_MODEL__IS_SENTENCE_TRANSFORMERS_MODEL=true

# --- Alternative models (uncomment to use): ---
# EMBEDDING_MODEL__MODEL=dkleczek/bert-base-polish-cased-v1
# EMBEDDING_MODEL__IS_SENTENCE_TRANSFORMERS_MODEL=false

# EMBEDDING_MODEL__MODEL=sdadas/st-polish-paraphrase-from-mpnet
# EMBEDDING_MODEL__IS_SENTENCE_TRANSFORMERS_MODEL=true

# EMBEDDING_MODEL__MODEL=sdadas/mmlw-retrieval-roberta-base
# EMBEDDING_MODEL__IS_SENTENCE_TRANSFORMERS_MODEL=true

# --- Optional - Qdrant ---
# QDRANT__HOST=localhost
# QDRANT__PORT=6333

# --- Optional - HNSW (adjust to collection size and hardware) ---
# HNSW__M=32
# HNSW__EF_CONSTRUCT=200

# --- Optional - Hardware & Performance ---
# DEVICE=cuda
# HALF_PRECISION=false
# ENCODING_BATCH_SIZE=256
# UPLOAD_BATCH_SIZE=10000